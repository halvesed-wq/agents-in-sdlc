---
const target = `${import.meta.env.BASE_URL}ko-kr/real-world-development/cli/10-review/`;
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="ko-KR" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>마무리 레슨으로 이동합니다</title>
  </head>
  <body>
    <a href={target}>이 레슨이 이동했습니다. 마무리 및 다음 단계로 계속 진행합니다.</a>
  </body>
</html>
